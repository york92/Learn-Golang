[Unit]
Description=IM Server (TCP + WebSocket + HTTP)
After=network.target

[Service]
User=im
Group=im
ExecStart=/usr/local/bin/imserver -config /etc/im/config.json
Restart=on-failure
RestartSec=2
# 长连接服务需要足够的文件描述符
LimitNOFILE=1048576
# 优雅停机：收到 SIGTERM 后下发 Kick 并排空连接，最多等 20 秒
TimeoutStopSec=20
# 基础加固
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/im

[Install]
WantedBy=multi-user.target
